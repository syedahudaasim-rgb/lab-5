#include <stdio.h>

int main() {
    int units;
    char type;
    float bill;

    printf("Enter units consumed: ");
    scanf("%d", &units);

    printf("Enter customer type (D for Domestic, C for Commercial): ");
    scanf(" %c", &type);

    if (units <= 100) {
        bill = units * 10;
    } else if (units <= 300) {
        if (type == 'D' || type == 'd') {
            bill = units * 12;
        } else if (type == 'C' || type == 'c') {
            bill = units * 15;
        } else {
            printf("Invalid customer type\n");
            return 0;
        }
    } else {
        bill = units * 20;
    }

    printf("Total Electricity Bill: Rs. %.2f\n", bill);

    return 0;
}
